{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cache": {
    "Enabled": true,
    "Strategy": "Memory",
    "DefaultTtlMinutes": 15,
    "Features": {
      "Products": {
        "Enabled": true,
        "TtlMinutes": 30
      },
      "Navigation": {
        "Enabled": true,
        "TtlMinutes": 120
      },
      "Categories": {
        "Enabled": true,
        "TtlMinutes": 60
      },
      "Brands": {
        "Enabled": true,
        "TtlMinutes": 90
      },
      "Search": {
        "Enabled": false,
        "TtlMinutes": 5
      }
    }
  },
  "AppLogging": {
    "Enabled": true,
    "MinimumLevel": "Warning",
    "FilePath": "logs/log-.txt",
    "RetainedDays": 30
  },
  "ExceptionAlert": {
    "Enabled": true,
    "ToEmail": "dev@healthurwealth.com"
  }
}
