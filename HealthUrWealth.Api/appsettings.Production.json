{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cache": {
    "Enabled": true,
    "Strategy": "Memory",
    "DefaultTtlMinutes": 15,
    "Features": {
      "Products": {
        "Enabled": true,
        "TtlMinutes": 30
      },
      "Navigation": {
        "Enabled": true,
        "TtlMinutes": 120
      },
      "Categories": {
        "Enabled": true,
        "TtlMinutes": 60
      },
      "Brands": {
        "Enabled": true,
        "TtlMinutes": 90
      },
      "Search": {
        "Enabled": false,
        "TtlMinutes": 5
      }
    }
  }
}
